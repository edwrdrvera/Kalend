# Postgres connection string used by Drizzle (src/db/index.ts, drizzle.config.ts)
# and by Better Auth, which keeps its users and sessions in the same database.
# Any plain Postgres 15+ works, for example a local Docker container:
#   postgres://postgres:<password>@localhost:5432/kalend
DATABASE_URL=

# Signs and encrypts session cookies. Generate one with `openssl rand -base64 32`.
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The app's public origin, for example http://localhost:3000 in development.
BETTER_AUTH_URL=

# The MVP's one login. `bun run db:seed:demo` creates this account (or resets
# its password), and the dev-only sign-in route below signs in with it.
# DEMO_USER_EMAIL defaults to demo@kalend.app.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Set to 1 to enable GET /api/dev/sign-in, which signs the browser in as
# DEMO_USER_EMAIL with no form (for unattended verify runs). Only works under
# `bun run dev`; the route returns 404 otherwise.
KALEND_DEV_SIGN_IN=
