# Postgres connection string used by Drizzle (src/db/index.ts, drizzle.config.ts).
# Use the Supabase "Transaction" pooler connection string (port 6543) — the
# postgres-js client is configured with { prepare: false } specifically for it.
DATABASE_URL=

# Supabase project URL and anon (public) key, from Project Settings > API.
# Used by src/lib/supabase/client.ts (browser) and src/lib/supabase/server.ts
# (server). Safe to expose to the browser — NEXT_PUBLIC_* vars are inlined at
# build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key, from Project Settings > API. Only used locally by
# src/db/seed-demo-user.ts (`bun run db:seed:demo`) to create the MVP's one
# demo login, and by the dev-only demo sign-in route below. Bypasses Auth
# entirely: never expose it to the browser, never commit it, never set it in a
# deployed environment.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to enable GET /api/dev/sign-in, which signs the browser in as
# DEMO_USER_EMAIL with no password (for unattended verify runs). Only works
# under `bun run dev`; the route returns 404 otherwise.
KALEND_DEV_SIGN_IN=
