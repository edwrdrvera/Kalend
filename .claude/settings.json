{
  "permissions": {
    "allow": [
      "Bash(git worktree remove:*)",
      "Bash(git branch -D:*)",
      "Bash(git push origin --delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/guard-bash.ts\""
          }
        ]
      }
    ]
  }
}
