# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local coding-agent state and overrides
.claude/
.codex/
.agents/
AGENTS.md

# Local coding-agent hand-off notes
/CONTEXT.md
/HANDOFF*.md
# Ignore /docs entirely: keeps local plans and hand-off notes out of the
# repo. Already-tracked docs files (see git ls-files docs/) stay tracked
# because .gitignore does not affect files already in the index.
/docs/
